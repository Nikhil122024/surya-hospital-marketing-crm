rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN'; }
    match /{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && (isAdmin() || request.resource.size < 10 * 1024 * 1024);
    }
  }
}
